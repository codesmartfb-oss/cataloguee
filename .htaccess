Options -Indexes

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Bloquer les fichiers et répertoires sensibles
<FilesMatch "^(\.env|\.git|composer\.(json|lock)|phpunit\.xml|local\.php|.*\.sqlite.*)$">
    Require all denied
</FilesMatch>
RewriteRule ^(?:config|data|storage|src)(?:/|$) - [F,L]

# Un fichier PHP ne doit jamais être exécutable dans uploads/
RewriteRule ^uploads/.*\.(?:php|phtml|phar|php[0-9]*)$ - [F,L,NC]

<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>
